# Copier en .env et remplir. Ne jamais committer .env.

# --- Découverte ---
TWITCH_CLIENT_ID=            # https://dev.twitch.tv/console/apps (application gratuite)
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=             # Google Cloud Console → YouTube Data API v3 → clé d'API

# --- Montage (OpenShorts) ---
# Cloud : https://api.openshorts.app + clé osk_... (compte openshorts.app)
# Auto-hébergé : http://localhost:8000, pas de clé, mais une clé Gemini
OPENSHORTS_API_URL=https://api.openshorts.app
OPENSHORTS_API_KEY=
GEMINI_API_KEY=              # auto-hébergé uniquement

# --- Google Drive (validation) ---
GOOGLE_OAUTH_CLIENT_ID=      # Google Cloud Console → Identifiants → ID client OAuth « Application de bureau »
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=  # donné par : python -m clipper drive-auth
GOOGLE_DRIVE_FOLDER_ID=      # donné par : python -m clipper drive-auth

# --- Compte de clips ---
# Nom du compte, sans @ : il remplace {account} dans la légende. Il reste ici et dans les
# secrets GitHub, jamais dans le dépôt, et il est masqué dans les journaux des passages.
ACCOUNT_HANDLE=

# --- Publication (Buffer, offre gratuite : Instagram + TikTok) ---
BUFFER_API_KEY=              # https://publish.buffer.com/settings/api

# --- Publication Instagram en direct (secours, sans Buffer) ---
# App Meta → Instagram → « API setup with Instagram login » → Generate token.
INSTAGRAM_ACCESS_TOKEN=      # jeton longue durée (60 jours, prolongé tout seul par l'agent)
INSTAGRAM_USER_ID=           # identifiant du compte professionnel, affiché à côté du jeton

# --- Publication (Upload-Post, facultatif : autres plateformes) ---
UPLOAD_POST_API_KEY=         # https://upload-post.com → API Keys
UPLOAD_POST_USER=            # nom du profil Upload-Post où TikTok / Instagram / YouTube sont connectés
